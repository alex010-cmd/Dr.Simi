# ============================================================================
# CONFIGURACIÓN DEL BACKEND - FARMACIA DISTRIBUIDA
# ============================================================================

# Entorno
NODE_ENV=development

# Servidor
PORT=3000
HOST=localhost

# Base de Datos Central
DB_CENTRAL_HOST=localhost
DB_CENTRAL_PORT=3306
DB_CENTRAL_NAME=farmacia_central
DB_CENTRAL_USER=root
DB_CENTRAL_PASSWORD=tu_password_aqui

# Base de Datos Local (Sucursal)
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=farmacia_suc001
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=tu_password_aqui

# JWT Configuration
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=tu_clave_refresh_muy_segura_aqui
JWT_REFRESH_EXPIRES_IN=7d

# Configuración de Sucursal
SUCURSAL_ID=1
SUCURSAL_CODIGO=SUC001

# Sincronización
SYNC_INTERVAL_MINUTES=5
SYNC_ENABLED=true

# Logs
LOG_LEVEL=info
LOG_FILE=logs/farmacia.log

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bcrypt
BCRYPT_SALT_ROUNDS=10
